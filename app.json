{
  "expo": {
    "name": "companion",
    "slug": "companionapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#7c6df0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourcompany.companion",
      "adaptiveIcon": {
        "backgroundColor": "#7c6df0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "sdkVersion": "55.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "43abc4f1-0c1a-4c7f-a465-b3d8e8df2410"
      }
    }
  }
}
